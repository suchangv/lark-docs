{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "lark-docs",
	"main": "worker/index.ts",
	"compatibility_date": "2025-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"observability": { "enabled": true },
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": ["/*"],
		"not_found_handling": "single-page-application"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "lark-docs-db",
			"database_id": "b9c42646-7ab3-40c9-9775-8a6ddf8802f2",
			"migrations_dir": "migrations"
		}
	],
	"routes": [
		{ "pattern": "lark.suchangv.com", "custom_domain": true },
		{ "pattern": "lark-mcp.suchangv.com", "custom_domain": true }
	],
	"vars": {
		"ACCESS_TEAM_DOMAIN": "suchangv.cloudflareaccess.com",
		"ACCESS_AUD": "5e52735f4babd91515851245492d98fd479e3329d04bb1f64783f12b411f8863",
		"ALLOWED_EMAILS": "suchangv@gmail.com",
		"DEV_AUTH_BYPASS": "false",
		"MCP_HOST": "lark-mcp.suchangv.com",
		"MCP_CORS_ORIGINS": "*",
		"DOC_PUBLIC_BASE_URL": "https://lark.suchangv.com"
	}
}
